# Adjust paths and user permissions according to your deployment.
[Unit]
Description=PIVX Name Indexer Stalled Lock Watchdog
After=network.target

# Started ONLY by pivx-name-indexer-watchdog.timer. Same reasoning as the sync service:
# RefuseManualStart blocks `systemctl start` while leaving timer activation alone, and
# there is deliberately no [Install] section. Enable the .timer instead.
RefuseManualStart=yes

[Service]
Type=oneshot
User=www-data
Group=www-data
WorkingDirectory=/var/www/pivx-name-indexer

# Read-only check of resources/sync.lock. It never takes the lock, so it can safely run
# while a sync run is in progress - which is the only time it has anything to report.
ExecStart=/usr/bin/php indexer.php watchdog
