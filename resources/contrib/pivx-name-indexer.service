# Adjust paths and user permissions according to your deployment.
[Unit]
Description=PIVX Name Indexer Sync Service
After=network.target mariadb.service mysql.service rr-proxy-indexer.service

# Started ONLY by pivx-name-indexer.timer.
#
# RefuseManualStart blocks `systemctl start`; timer activation is not a manual job and
# is unaffected. There is deliberately no [Install] section: WantedBy=multi-user.target
# here would enable the service in its own right and run it once at boot, outside the
# timer's control and before the boot delay the timer applies. Enable the .timer instead.
RefuseManualStart=yes

[Service]
Type=oneshot
User=www-data
Group=www-data
WorkingDirectory=/var/www/pivx-name-indexer
ExecStart=/usr/bin/php indexer.php sync
