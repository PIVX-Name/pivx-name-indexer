# Indexer overrides. Loaded from /etc/mysql/conf.d/ after the packaged defaults.
#
# `secure_log_path` used to live here — that is a Percona Server variable, and stock MySQL
# 8.4 refuses to start on an unknown one.
[client]
socket = /run/mysqld/mysqld.sock

[mysql]
socket = /run/mysqld/mysqld.sock

[mysqld]
datadir  = /var/lib/mysql
socket   = /run/mysqld/mysqld.sock
pid_file = /run/mysqld/mysqld.pid
tmpdir   = /tmp
user     = mysql

# Never reachable from outside the container; the indexer talks to it over the socket.
bind_address    = 127.0.0.1
port            = 3306
mysqlx          = 0
local_infile    = 0
skip_name_resolve = 1

log_error = /var/log/mysql/error.log

max_allowed_packet  = 16M
tmp_table_size      = 32M
max_heap_table_size = 32M
key_buffer_size     = 0

# Single node, no replicas: the binlog would only cost writes and disk.
server_id       = 1
disable_log_bin
slow_query_log  = 0

innodb_temp_data_file_path = ibtmp1:12M:autoextend:max:512M
innodb_redo_log_capacity   = 128M
innodb_undo_log_truncate   = ON
innodb_max_undo_log_size    = 128M
