# Copy to .env beside docker-compose.yml and fill in.

# --- Database -------------------------------------------------------------------------
# Leave empty to have one generated on first start and stored with the data volume.
DB_PASSWORD=

# --- PIVX -----------------------------------------------------------------------------
# PIVX Core wallet JSON-RPC. The indexer reads every protocol command from here, so all
# four are required: the container refuses to start without them rather than boot healthy
# and then scan nothing.
RPC_HOST=
RPC_PORT=51473
RPC_USER=
RPC_PASS=

# --- EVM anchor -----------------------------------------------------------------------
# Chain the anchor contract lives on. 56 = BNB Smart Chain.
# Must match EVM_NETWORK.chain_id in the indexer config.
EVM_CHAIN_ID=56

# Endpoints for that chain, comma-separated. Seeded into rpc_list on first start only;
# afterwards edit the table directly.
#
# Checkpoint discovery uses eth_call exclusively — eth_getLogs is refused outright by the
# public endpoints below (measured: not even a ten-block range), and it is also the wrong
# source, since a rolled-back root stays in the log stream for ever. eth_call works on
# every endpoint, free or paid. Official BNB Smart Chain public endpoints:
EVM_RPC_URL=https://bsc-dataseed.bnbchain.org,https://bsc-dataseed.nariox.org,https://bsc-dataseed.defibit.io,https://bsc-dataseed.ninicoin.io,https://bsc.nodereal.io,https://bsc-dataseed-public.bnbchain.org

# --- Notifications (optional) ---------------------------------------------------------
NOTIFY_TYPE=
NOTIFY_TG_BOT_KEY=
NOTIFY_TG_USER_ID=

# --- EVM pacing --------------------------------------------------------------------
# Microseconds to sleep after each eth_call (200000 = 0.2s). 0 disables it.
# The limit on public endpoints is per-second concurrency, not total volume: 600
# sequential calls succeed where 100 at once do not. Discovery is sequential, so 0 suits
# most endpoints — raise it only if one starts answering "limit exceeded".
EVM_THROTTLING=0

# Checkpoints fetched and persisted per database transaction. Bounds how much work an
# interrupted sync loses: at most one chunk, since the walk resumes from the highest
# stored index.
EVM_BATCH_SIZE=10
